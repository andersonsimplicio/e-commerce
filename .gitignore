 
 
cat << 'EOF' > .gitignore


# Ambientes virtuais
.venv/
venv/
ENV/

# Python / Bytecode
__pycache__/
*.py[cod]
*$py.class

# Django e dados locais
*.sqlite3
*.log
local_settings.py
media/
staticfiles/

# Variáveis de ambiente
.env

# IDEs e Sistema Operacional
.vscode/
.idea/
.DS_Store
*.swp
EOF